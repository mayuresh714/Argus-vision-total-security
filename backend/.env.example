PORT=4000
JWT_SECRET=change-me-in-production
CORS_ORIGIN=http://localhost:5173

# Sampling cadence in seconds (k)
SAMPLE_INTERVAL_SECONDS=5

# Tier 1 (fast local scan) - always runs on every sampled frame
TIER1_SUSPICION_THRESHOLD=0.35

# Tier 2 (local VLM) - runs only when tier 1 is unsure (>= threshold)
TIER2_ENDPOINT=http://localhost:8001/v1/analyze
TIER2_CONFIDENCE_ESCALATE_BELOW=0.6

# Tier 3 (sophisticated / frontier model) - runs only when tier 2 is still unsure
TIER3_ENDPOINT=http://localhost:8002/v1/analyze
TIER3_PROVIDER=none

ALERT_SCORE_THRESHOLD=0.55
